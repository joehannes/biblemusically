<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Speaking to the guides.

      `navigator.mediaDevices.getUserMedia({ audio: true })` cannot succeed without this: Android
      refuses the request before the user is ever asked, so the app's own "Allow microphone" button
      reported a refusal nobody had made. Declared here and requested at the moment it is used —
      the Permissions step in the setup guide — rather than at launch.

      RECORD_AUDIO is a runtime permission on Android 6+, so this declaration is necessary and not
      sufficient: the WebView must also grant the page's request when it arrives. See
      MainActivity.kt, which is where that happens.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Opening a sign-in page in the user's real browser. Android 11+ hides other apps unless the
         intents you send are declared, and a bare ACTION_VIEW for https is otherwise answered by
         nothing at all — which looked exactly like a button that does not work. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
      Installing an update the app downloaded itself.

      On Android an app cannot replace itself the way a desktop package manager does: the downloaded
      APK has to be handed to the system installer, and handing it over is what this permission
      allows. Without it the Update button can fetch the new version and then do nothing with it,
      which is where this app stood — a download that landed in a folder the user cannot easily reach
      and an installer that was never invoked.

      What it is not: permission to install anything silently. It only allows *asking*. The system
      still shows its own "do you want to install this?" screen, the user still has to grant this app
      "install unknown apps" in Settings once (Android 8+ makes that per-app rather than global), and
      the update still has to be signed with the same key as the copy already installed. See
      InstallPlugin.kt, which checks `canRequestPackageInstalls()` before it offers to do anything,
      and the Permissions step in the setup guide, where it is explained before it is ever needed.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ai_music_video_studio"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!--
              Coming back from a sign-in that happened in the system browser (RFC 8252).

              Google and Kaggle refuse to sign in inside an embedded webview, so the browser is not a
              preference — it is the only way. Which leaves the return journey: without this filter
              the browser finishes the flow, shows a page nobody can act on, and the app never learns
              that consent was granted. `launchMode="singleTask"` above is what makes the callback
              land in the running activity rather than starting a second copy of the app.

              Two schemes, because two things need to come back:
                * the app's own — used for pairing links and any provider that accepts a custom scheme;
                * Google's reverse client id — which is derived from the OAuth client the *user*
                  creates, so it cannot be known when this file is written. It comes in as a Gradle
                  manifest placeholder; see build.gradle.kts, which defaults it to the app id so a
                  build without one is still a valid manifest rather than a broken one.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="studio.lightkid.app" />
                <data android:scheme="${googleRedirectScheme}" />
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter android:autoVerify="true" >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="studio-lightkid.johannes-neugschwentner.workers.dev" />
                
                
                <data android:pathPrefix="/oauth" />
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
