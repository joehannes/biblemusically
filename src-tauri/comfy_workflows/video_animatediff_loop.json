{
  "_comment": "AnimateDiff v3 on SD 1.5 — a short seamless loop for behind text. Uses ComfyUI-AnimateDiff-Evolved (ADE_* nodes), which the video notebook installs; unlike the other three graphs this one DEPENDS on a custom node pack, so a version bump upstream can break it in a way the native graphs cannot. context_length 16 with the sliding context is what makes the loop close; without it the clip drifts and the seam shows.",
  "10": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "__CKPT__"}},
  "20": {"class_type": "ADE_AnimateDiffLoaderGen1", "inputs": {"model": ["10", 0], "model_name": "__MOTION__", "beta_schedule": "sqrt_linear (AnimateDiff)", "context_options": ["21", 0]}},
  "21": {"class_type": "ADE_AnimateDiffUniformContextOptions", "inputs": {"context_length": 16, "context_stride": 1, "context_overlap": 4, "context_schedule": "uniform", "closed_loop": true, "fuse_method": "flat", "use_on_equal_length": false, "start_percent": 0.0, "guarantee_steps": 1}},
  "5":  {"class_type": "EmptyLatentImage", "inputs": {"width": __WIDTH__, "height": __HEIGHT__, "batch_size": __FRAMES__}},
  "6":  {"class_type": "CLIPTextEncode", "inputs": {"text": "__PROMPT__", "clip": ["10", 1]}},
  "7":  {"class_type": "CLIPTextEncode", "inputs": {"text": "__NEGATIVE__", "clip": ["10", 1]}},
  "3":  {"class_type": "KSampler", "inputs": {"seed": __SEED__, "steps": __STEPS__, "cfg": __CFG__, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0, "model": ["20", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]}},
  "8":  {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["10", 2]}},
  "9":  {"class_type": "SaveWEBM", "inputs": {"images": ["8", 0], "filename_prefix": "bm_video", "codec": "vp9", "fps": __FPS__, "crf": 32}}
}
