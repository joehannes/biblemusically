  "18": {"class_type": "VAEEncode", "inputs": {"pixels": ["43", 0], "vae": ["4", 2]}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "__PROMPT__", "clip": ["4", 1]}},
