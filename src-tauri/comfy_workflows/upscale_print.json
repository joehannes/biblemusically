{
  "_comment": "Upscale and detail pass, for print. 1024px art into a 4000px print area is 77 DPI — a refund, not a product (see print_quality in commands/printify.rs). A plain resize would only make a soft image bigger, so this is a real two-stage pass: an upscale model first, then a low-denoise sampler that puts detail back into the enlarged pixels rather than inventing a new picture.",
  "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "__CKPT__"}},
  "10": {"class_type": "LoadImage", "inputs": {"image": "__INPUT_IMAGE__"}},
  "15": {"class_type": "UpscaleModelLoader", "inputs": {"model_name": "__UPSCALER__"}},
  "16": {"class_type": "ImageUpscaleWithModel", "inputs": {"upscale_model": ["15", 0], "image": ["10", 0]}},
  "17": {"class_type": "ImageScale", "inputs": {"image": ["16", 0], "upscale_method": "lanczos", "width": __WIDTH__, "height": __HEIGHT__, "crop": "disabled"}},
  "18": {"class_type": "VAEEncode", "inputs": {"pixels": ["17", 0], "vae": ["4", 2]}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "__PROMPT__", "clip": ["4", 1]}},
  "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "__NEGATIVE__", "clip": ["4", 1]}},
  "3": {"class_type": "KSampler", "inputs": {"seed": __SEED__, "steps": __STEPS__, "cfg": __CFG__, "sampler_name": "__SAMPLER__", "scheduler": "__SCHEDULER__", "denoise": __DENOISE__, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["18", 0]}},
  "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
  "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "biblemusically-print", "images": ["8", 0]}}
}
