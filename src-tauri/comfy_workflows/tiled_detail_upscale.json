{
  "_comment": "Twice the size with detail added, using no upscale model at all. upscale_print needs a .pth in models/upscale_models; a server without one fails there, and this is the fallback that always works: scale the pixels, re-encode, and let the sampler put detail back at low denoise. Softer than a real ESRGAN pass, and available on a bare ComfyUI install.",
  "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "__CKPT__"}},
  "10": {"class_type": "LoadImage", "inputs": {"image": "__INPUT_IMAGE__"}},
  "42": {"class_type": "ImageScaleBy", "inputs": {"upscale_method": "lanczos", "scale_by": 2.0, "image": ["10", 0]}},
  "18": {"class_type": "VAEEncode", "inputs": {"pixels": ["42", 0], "vae": ["4", 2]}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "__PROMPT__", "clip": ["4", 1]}},
  "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "__NEGATIVE__", "clip": ["4", 1]}},
  "3": {"class_type": "KSampler", "inputs": {"seed": __SEED__, "steps": __STEPS__, "cfg": __CFG__, "sampler_name": "__SAMPLER__", "scheduler": "__SCHEDULER__", "denoise": __DENOISE__, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["18", 0]}},
  "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
  "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "biblemusically", "images": ["8", 0]}}
}
